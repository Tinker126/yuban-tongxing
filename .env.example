# Copy this example to .env and fill values privately. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3101
APP_ORIGIN=http://localhost:3101
TRUST_PROXY_HOPS=0
DATABASE_URL=your_database_url_here
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-flash
SESSION_SECRET=your_random_secret_here
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD_HASH=
STT_PROVIDER=disabled
TENCENT_ASR_SECRET_ID=your_secret_id_here
TENCENT_ASR_SECRET_KEY=your_secret_key_here
STT_FFMPEG_PATH=ffmpeg
STT_DAILY_LIMIT=500
DAILY_AI_LIMIT=1000
MAX_RECORDS=20000
MAX_DATA_MB=100
DATA_FILE=./data/userData.json
